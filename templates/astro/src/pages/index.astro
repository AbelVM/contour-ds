---
import Base from "../layouts/Base.astro";
---
<Base>
  <main class="container" style="padding-block: var(--space-xl);">
    <h1 class="c-section-head__title">Contour · Astro starter</h1>
    <p class="muted">A minimal Astro site wired to Contour.</p>
    <button class="c-btn c-btn--primary" style="margin-block-start: var(--space-cluster);">
      Compute route
    </button>
    <div class="c-kpi" style="margin-block-start: var(--space-cluster);">
      <div class="c-kpi__value">42</div>
      <div class="c-kpi__label">Routes matched</div>
    </div>
  </main>
</Base>
