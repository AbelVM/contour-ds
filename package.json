{
  "name": "contour-ds",
  "version": "1.7.2",
  "description": "A token-driven design system for spatial interfaces",
  "license": "MIT",
  "type": "module",
  "main": "dist/contour.css",
  "module": "dist/contour.esm.js",
  "style": "dist/contour.css",
  "files": [
    "dist/",
    "integrations/"
  ],
  "scripts": {
    "build:core": "node tools/build.mjs",
    "generate:storybook": "node tools/gen-storybook-stories.mjs",
    "build": "npm run build:core && npm run generate:storybook && storybook build --output-dir storybook",
    "snippets": "node tools/snippets.mjs",
    "check:tokens": "node tools/check-tokens.mjs",
    "check:dead-css": "node tools/check-dead-css.mjs",
    "check:motion": "node tools/check-motion.mjs",
    "check:defs": "node tools/check-defs.mjs",
    "check:light-dark": "node tools/gen-light-dark.mjs --check",
    "check:claims": "node tools/check-claims.mjs",
    "check:markup": "node tools/check-markup.mjs",
    "check:layout": "node tools/check-layout.mjs",
    "check:theme": "node tools/audit/theme-render-probe.mjs",
    "check:chart": "node tools/audit/chart-geometry.mjs",
    "check:chart-names": "node tools/audit/chart-names.mjs",
    "validate": "npx html-validate index.html templates/*.html",
    "prepack": "node tools/build.mjs --single",
    "check:docs-exec": "node tools/execute-docs.mjs",
    "check:reflow": "node tools/audit/check-reflow.mjs",
    "check:doctor": "node tools/doctor.mjs",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "storybook": "npm run build:core && npm run generate:storybook && storybook dev -p 6006",
    "build:storybook": "npm run build",
    "build-storybook": "npm run build:storybook",
    "test:storybook": "npm run build && node tools/storybook-tests.mjs",
    "check:storybook-coverage": "node tools/check-storybook-coverage.mjs",
    "screenshot:baseline": "node tools/screenshot-baseline.mjs",
    "check:storybook": "npm run build-storybook && node tools/storybook-tests.mjs && npm run check:storybook-coverage",
    "check:diagnostics": "node tools/check-diagnostics.mjs",
    "check:dsd": "node tools/check-dsd.mjs",
    "check:recipes": "node tools/check-recipes.mjs",
    "check:perf": "node tools/audit/perf-budget.mjs",
    "check:docs-behaviours": "node tools/audit/docs-behaviours.mjs",
    "check:workspace-shell": "node tools/audit/workspace-shell.mjs",
    "check:glass": "node tools/audit/glass-budget.mjs",
    "check:visual": "node tools/check-visual.mjs",
    "visual:baseline": "node tools/check-visual.mjs --baseline",
    "visual:check": "node tools/check-visual.mjs --compare"
  },
  "keywords": [
    "design-system",
    "css",
    "tokens",
    "spatial",
    "maps",
    "geospatial"
  ],
  "exports": {
    ".": {
      "types": "./dist/contour.d.ts",
      "style": "./dist/contour.css",
      "default": "./dist/contour.css"
    },
    "./contour.css": "./dist/contour.css",
    "./contour.min.css": "./dist/contour.min.css",
    "./contour.js": "./dist/contour.js",
    "./contour.min.js": "./dist/contour.min.js",
    "./surfaces/*": "./dist/surfaces/*",
    "./fonts/*": "./dist/fonts/*",
    "./tokens": "./dist/contour.tokens.json",
    "./tokens.json": "./dist/contour.tokens.json",
    "./themes": "./dist/contour.themes.json",
    "./themes.json": "./dist/contour.themes.json",
    "./components": "./dist/contour.components.json",
    "./components.json": "./dist/contour.components.json",
    "./map-chrome/*": "./dist/map-chrome.*.css",
    "./svg/*": "./dist/svg/*",
    "./hljs.css": "./dist/hljs.css",
    "./contour.single.min.css": "./dist/contour.single.min.css",
    "./map-chrome/mapbox": "./dist/map-chrome.mapbox.css",
    "./map-chrome/maplibre": "./dist/map-chrome.maplibre.css",
    "./contour-wc.js": "./dist/contour-wc.js",
    "./contour-wc.min.js": "./dist/contour-wc.min.js",
    "./contour.esm.js": "./dist/contour.esm.js",
    "./contour.esm.min.js": "./dist/contour.esm.min.js",
    "./contour-wc.esm.js": "./dist/contour-wc.esm.js",
    "./contour-wc.esm.min.js": "./dist/contour-wc.esm.min.js",
    "./wc/*": "./dist/wc/*",
    "./package.json": "./package.json",
    "./agent-rules": "./dist/agent-rules.json",
    "./agent-rules.json": "./dist/agent-rules.json",
    "./html-data": "./dist/contour.html-data.json",
    "./html-data.json": "./dist/contour.html-data.json",
    "./web-types": "./dist/contour.web-types.json",
    "./web-types.json": "./dist/contour.web-types.json",
    "./react": {
      "types": "./dist/contour.react.d.ts"
    },
    "./react.d.ts": "./dist/contour.react.d.ts",
    "./vue": {
      "types": "./dist/contour.vue.d.ts"
    },
    "./vue.d.ts": "./dist/contour.vue.d.ts",
    "./custom-elements": "./dist/custom-elements.json",
    "./custom-elements.json": "./dist/custom-elements.json",
    "./custom-elements-manifest": "./dist/custom-elements.json",
    "./snippets": "./dist/contour.code-snippets",
    "./code-snippets": "./dist/contour.code-snippets"
  },
  "sideEffects": [
    "*.css",
    "*.js"
  ],
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@storybook/addon-a11y": "^10.6.7",
    "@storybook/addon-docs": "^10.6.7",
    "@storybook/addon-mcp": "^10.6.7",
    "@storybook/addon-vitest": "^10.6.7",
    "@storybook/web-components-vite": "^10.6.7",
    "@vitest/browser-playwright": "^5.1.0",
    "@vitest/coverage-v8": "^5.1.0",
    "ajv": "8.20.0",
    "dembrandt": "0.39.2",
    "html-validate": "11.21.0",
    "jsdom": "^31.0.0",
    "lit": "3.3.3",
    "playwright-core": "1.65.0",
    "storybook": "^10.6.7",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "author": "Abel V\u00e1zquez Montoro",
  "repository": {
    "type": "git",
    "url": "https://github.com/AbelVM/contour-ds.git"
  },
  "homepage": "https://github.com/AbelVM/contour-ds",
  "bugs": {
    "url": "https://github.com/AbelVM/contour-ds/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "customElements": "dist/custom-elements.json"
}
